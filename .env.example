# Copy this file to .env and fill in real values.
# NEVER commit the real .env file. It is already listed in .gitignore.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# Comma-separated list of origins allowed to call the public API.
# The static site is served separately by GitHub Pages
# (https://carbon-conqueror.github.io/Amri-akka-), a different origin than
# this API - it must be listed here or the browser will reject every
# fetch() call from donate.html/admin. Do NOT use "*" here.
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://carbon-conqueror.github.io

# Public base URL of this deployment (used for building absolute links).
PUBLIC_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Razorpay - Test Mode keys first. Get these from:
# https://dashboard.razorpay.com/app/keys (toggle to Test Mode)
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret_here

# From Razorpay Dashboard > Account & Settings > Webhooks > (your webhook) > Secret
# Must match exactly what you configure in the Razorpay dashboard for this endpoint.
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ---------------------------------------------------------------------------
# Donation limits (server is the source of truth - the browser cannot override these)
# Values are in whole INR rupees.
# ---------------------------------------------------------------------------
DONATION_MIN_AMOUNT_INR=10
DONATION_MAX_AMOUNT_INR=500000

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------
# International/foreign-currency donations are OFF by default. Amrix Forde is
# an Indian charitable organisation; accepting foreign contributions may
# require FCRA registration and other regulatory approval. Do not enable this
# until Amrix Forde's legal/accounting team has confirmed compliance AND the
# Razorpay account is authorised for the relevant flow.
ENABLE_INTERNATIONAL_DONATIONS=false

# 80G tax-deduction claims must not be shown on receipts until Amrix Forde
# actually holds a valid, current 80G registration and someone has verified
# the receipt wording meets the applicable requirements. Keep false until
# that verification has happened.
ENABLE_80G_RECEIPT_CLAIM=false
EIGHTY_G_REGISTRATION_NUMBER=

# ---------------------------------------------------------------------------
# Admin dashboard
# ---------------------------------------------------------------------------
# Generate a bcrypt hash with: npm run seed:admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=
# Random 32+ byte secret for signing admin session cookies. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
